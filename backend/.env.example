# PostgreSQL connection string (production)
DATABASE_URL="postgresql://hms_user:changeme@localhost:5432/hms_db?schema=public"

# For quick local testing WITHOUT installing Postgres, you can instead set
# provider = "sqlite" in prisma/schema.prisma and use:
# DATABASE_URL="file:./dev.db"

JWT_SECRET="change_this_to_a_long_random_string_in_production"
JWT_EXPIRES_IN="8h"

PORT=4000
CORS_ORIGIN="http://localhost:5173"

